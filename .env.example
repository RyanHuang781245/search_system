DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
DJANGO_TIME_ZONE=Asia/Taipei

MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=document_retrieval_system

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=meeting_items
QDRANT_VECTOR_DIMENSION=768
QDRANT_SCORE_THRESHOLD=0.7

OLLAMA_HOST=localhost
OLLAMA_PORT=10000
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_INFERENCE_MODEL=qwen2.5:3b

GRAPHRAG_QUERY_ROUTER_MODE=deterministic_first
GRAPHRAG_QUERY_ROUTER_LLM_ENABLED=1
GRAPHRAG_QUERY_ROUTER_LLM_TIMEOUT=8
GRAPHRAG_EVIDENCE_SELECTOR_ENABLED=1
GRAPHRAG_EVIDENCE_SELECTOR_TIMEOUT=20

GRAPH_QUERY_PLANNER_MODE=deterministic_first
GRAPH_QUERY_PLANNER_LLM_ENABLED=1
GRAPH_INTENT_LLM_TIMEOUT=12
TEXT2CYPHER_LLM_TIMEOUT=45
TEXT2CYPHER_MAX_LIMIT=50
TEXT2CYPHER_ENABLE_NODE_EXPANSION=false
TEXT2CYPHER_EXPANSION_PER_NODE_LIMIT=10

KEYWORD_LLM_ENABLED=True
KEYWORD_LLM_TIMEOUT=12
KEYWORD_LLM_MAX_INPUT_CHARS=1800
KEYWORD_EMBEDDING_RERANK_ENABLED=True
KEYWORD_EMBEDDING_RERANK_LIMIT=18
KEYWORD_EMBEDDING_MAX_INPUT_CHARS=1800
KEYWORD_EMBEDDING_TIMEOUT=10

DEIDENTIFICATION_ENABLED=False
DEIDENTIFICATION_SALT=
DEIDENTIFICATION_MAPPING_FILE=
